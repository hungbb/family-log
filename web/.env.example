# `npm run dev` works without this: the development defaults are committed in `.env.development`.
# Copy this file to `.env.local` (git-ignored) only if your setup differs — it overrides the
# defaults. A production build reads neither; set the variables in the environment it is built in.
#
# Only variables prefixed VITE_ reach the browser bundle. Never put a secret here — everything in
# this file is compiled into publicly served JavaScript.

# Origin of the API, without a trailing slash. The client appends /api/v1 itself.
VITE_API_BASE_URL=http://localhost:8080
