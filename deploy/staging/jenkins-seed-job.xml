<?xml version='1.1' encoding='UTF-8'?>
<!--
  Jenkins job "giaky-staging-seed": pipeline from SCM, reading deploy/staging/Jenkinsfile.seed.

  Create it by POSTing this file to http://192.168.1.100:8080/createItem?name=giaky-staging-seed
  (the exact curl command is in deploy/staging/README.md). Update it later by POSTing it to
  http://192.168.1.100:8080/job/giaky-staging-seed/config.xml.

  No trigger on purpose: seeding is something you ask for, after a fresh staging database.

  No double hyphens anywhere in this comment: XML forbids them, and Jenkins rejects the file.
-->
<flow-definition plugin="workflow-job">
  <description>Gia Ký — fill staging (http://192.168.1.100:8081) with the demo clan and its four test accounts. Manual; safe to rerun.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
      <abortPrevious>false</abortPrevious>
    </org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>BASE_URL</name>
          <description>Where staging answers, as seen from the Jenkins host.</description>
          <defaultValue>http://127.0.0.1:8081</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SEED</name>
          <description>Random seed; the same seed always builds the same tree.</description>
          <defaultValue>20261112</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>git@github.com:hungbb/family-log.git</url>
          <credentialsId>github-ssh</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>deploy/staging/Jenkinsfile.seed</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
