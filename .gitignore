# --- Secrets ------------------------------------------------------------------------------------
# `.env.example` files are committed and documented; anything with real values is not.
.env
.env.*
!.env.example

# --- Java / Maven -------------------------------------------------------------------------------
target/
*.class
*.jar
# The wrapper is the script-only distribution, so there is no jar to commit and any that appears
# is a stray download.
**/.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# --- Node ---------------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
coverage/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Local runtime data -------------------------------------------------------------------------
# Uploaded media in dev; see MEDIA_LOCAL_DIR.
var/
api/var/
*.log
logs/

# --- Editors ------------------------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# --- OS -----------------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
