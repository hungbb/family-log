<?xml version="1.0" encoding="UTF-8"?>
<!--
  Human-readable logs everywhere but production, structured JSON in production.

  The split is by `prod` rather than by `dev` so that a locally run profile nobody anticipated still
  produces readable output; only a real deployment pays for JSON.

  Both encoders carry the correlation id set by CorrelationIdFilter, so one request can be followed
  across every line it produced — and an error body's `correlationId` leads straight to its stack.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="gia-ky-api"/>

  <springProfile name="!prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%X{correlationId:--}]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx</pattern>
        <charset>UTF-8</charset>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="prod">
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <includeMdcKeyName>correlationId</includeMdcKeyName>
        <customFields>{"application":"${appName}"}</customFields>
        <fieldNames>
          <timestamp>timestamp</timestamp>
          <version>[ignore]</version>
          <levelValue>[ignore]</levelValue>
        </fieldNames>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON"/>
    </root>
  </springProfile>
</configuration>
