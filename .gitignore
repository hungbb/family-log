# ---------------------------------------------------------------------------
# Gia Ký — root .gitignore
# Monorepo: api/ (Java 21 · Spring Boot · Maven) + web/ (Vite · React · TS)
# ---------------------------------------------------------------------------

# === OS ===
.DS_Store
Thumbs.db
Desktop.ini

# === IDE / editors ===
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo

# === Secrets & environment ===
.env
.env.*
!.env.example
*.local

# === Local media storage (uploaded avatars/images live outside git) ===
/media/
api/media/
uploads/

# ---------------------------------------------------------------------------
# Backend — api/ (Maven / Spring Boot)
# ---------------------------------------------------------------------------
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.log
hs_err_pid*
replay_pid*

# Spring Boot local overrides
application-local.yml
application-local.properties

# ---------------------------------------------------------------------------
# Frontend — web/ (Node / Vite)
# ---------------------------------------------------------------------------
node_modules/
web/dist/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Lighthouse / bundle analysis output
.lighthouseci/
stats.html

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.tmp
*.bak
coverage/
