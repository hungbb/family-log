# Defaults for `npm run dev` — committed, so a fresh clone reaches a locally running API with no
# setup at all. The API's `dev` profile does the same thing on its side (application-dev.yml).
#
# Vite loads this file only in development mode; `npm run build` never reads it, so a production
# bundle still gets its origin from the environment it is built in.
#
# To point at something else, copy `.env.example` to `.env.local` (git-ignored) — it wins over this.

# Origin of the API, without a trailing slash. The client appends /api/v1 itself.
VITE_API_BASE_URL=http://localhost:8080
