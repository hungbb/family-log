# Rendered at container start by the nginx image (envsubst over ${API_UPSTREAM}, ${LISTEN_PORT}).

# In production a second nginx (on the host) terminates TLS and proxies here over plain HTTP, so
# $scheme is "http" inside this container and would downgrade what Spring sees behind it. Honour
# the header the outer proxy sent, and fall back to $scheme when there is no outer proxy (staging).
# This trusts whatever reaches this container with the header, so the only thing that should be
# able to is the proxy in front of it — on staging, where nginx is exposed directly, a client could
# claim https. Nothing authorizes on the scheme; it only shapes the URLs Spring builds.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${LISTEN_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;
    server_tokens off;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- API (same origin) ---------------------------------------------------------------------
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_read_timeout 60s;
    }

    # Health only — /actuator/prometheus stays internal.
    location = /actuator/health {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # API docs (enabled on staging via SWAGGER_UI_ENABLED).
    location ~ ^/(v3/api-docs|swagger-ui) {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host  $http_host;
    }

    # --- Static bundle -------------------------------------------------------------------------
    # Hashed file names: cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: every other path is a client-side route. index.html must never be cached, or a deploy
    # leaves browsers pointing at asset hashes that no longer exist.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
