# Copy to `api/.env` (git-ignored) and fill in for your machine.
#
# The `dev` profile has local-only defaults for everything below, so a fresh clone runs without
# this file at all. Set these when your local setup differs — or when running any profile other
# than `dev`, where there are no defaults and a missing value stops the application at startup.
#
# Never commit a filled-in copy. This file is the documentation; `.env` is the secret.

# --- Database ----------------------------------------------------------------------------------
# PostgreSQL 16, installed natively. See the root README for creating the role and database.
DB_URL=jdbc:postgresql://localhost:5432/giaky
DB_USERNAME=giaky
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- HTTP --------------------------------------------------------------------------------------
SERVER_PORT=8080
# Where this API is reachable; used as the server URL in the OpenAPI document.
API_BASE_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API. The Vite dev server is the only one
# locally. In prod this is required and must never be a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Media -------------------------------------------------------------------------------------
# Local directory uploads are written to (Phase 7). Object storage is a post-v1 adapter swap.
MEDIA_LOCAL_DIR=./var/media

# --- Authentication --------------------------------------------------------------------------
# The HS256 signing key for access tokens. Base64, decoding to at least 32 bytes — the application
# refuses to start on anything shorter, because a short HMAC key is one captured token away from
# being brute-forced offline.
#
# Generate one:
#   openssl rand -base64 32
#
# The `dev` profile has a published local-only default, so a fresh clone runs without this file.
# `prod` has no default at all: a deployment without a secret must fail at startup rather than sign
# tokens with a value that is in version control.
JWT_SECRET=

# The `iss` claim. Tokens from any other issuer are rejected, so this must match across a
# blue/green pair or every session breaks at the cutover.
JWT_ISSUER=giaky

# BCrypt work factor (FR-A2 requires at least 12). Raising it re-hashes nothing: the cost lives in
# each stored hash, so existing passwords keep verifying and new ones get the new factor.
BCRYPT_COST=12
