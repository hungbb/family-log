<?xml version='1.1' encoding='UTF-8'?>
<!--
  Jenkins job "giaky-prod": pipeline from SCM, reading deploy/prod/Jenkinsfile.

  Create it by POSTing this file to http://192.168.1.100:8080/createItem?name=giaky-prod
  (the exact curl command is in deploy/prod/README.md). Update it later by POSTing it to
  http://192.168.1.100:8080/job/giaky-prod/config.xml.

  No trigger on purpose: production is deployed by hand, from Build with Parameters. Staging
  (giaky-staging) is the job that follows main automatically.

  No double hyphens anywhere in this comment: XML forbids them, and Jenkins rejects the file.
-->
<flow-definition plugin="workflow-job">
  <description>Gia Ký — build main and deploy it to production on the ezgo host (https://giaky.etopfunvalue.com). Manual: Build with Parameters.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
      <abortPrevious>false</abortPrevious>
    </org.jenkinsci.plugins.workflow.job.properties.DisableConcurrentBuildsJobProperty>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.BooleanParameterDefinition>
          <name>RUN_TESTS</name>
          <description>Run the API and web test suites before building.</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>ROLLBACK_TAG</name>
          <description>Redeploy an image tag already in the registry (e.g. build-17), skipping test, build and push. Empty for a normal build of main.</description>
          <defaultValue></defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>git@github.com:hungbb/family-log.git</url>
          <!-- The same SSH key the staging job uses (a GitHub deploy key is enough). -->
          <credentialsId>github-ssh</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>deploy/prod/Jenkinsfile</scriptPath>
    <lightweight>true</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
